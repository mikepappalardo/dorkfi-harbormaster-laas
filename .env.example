# DorkFi Harbormaster LaaS

# Service wallet — holds repay capital and signs repay_on_behalf transactions
SERVICE_MNEMONIC=word1 word2 word3 ...
SERVICE_WALLET=YOUR_SERVICE_WALLET_ADDRESS

# Algorand node
ALGOD_TOKEN=
ALGOD_SERVER_VOI=https://mainnet-api.voi.nodely.dev
ALGOD_SERVER_ALGO=https://mainnet-api.algonode.cloud
ALGOD_PORT=443

# Telegram alerts (for service operator)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API server
PORT=3456

# Fee rate (default 0.001 = 0.1%)
FEE_RATE=0.001

# Trigger threshold — repay when HF drops below this
TRIGGER_HF=1.05

# Poll interval (seconds)
POLL_INTERVAL=60
